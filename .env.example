# =============================================================================
#  MAU CAU HINH - copy thanh .env roi sua
#      cp .env.example .env
#  (scripts/setup.sh tu lam buoc nay neu .env chua ton tai)
#
#  !!! KHONG BAO GIO commit file .env len git !!!
# =============================================================================

# -----------------------------------------------------------------------------
#  BAT BUOC SUA
# -----------------------------------------------------------------------------

# Ten mien tro toi VPS nay (ban ghi DNS A phai tro dung IP public cua VPS).
# Vi du: code.example.com
DOMAIN=code.example.com

# GHI CHU: khong con bien ACME_EMAIL. Chung chi Let's Encrypt do Traefik CO SAN
# tren VPS cap phat; email lien he nam trong traefik.yml cua stack Traefik do.

# Mat khau man hinh dang nhap CUA CHINH code-server (lop bao ve thu 2,
# nam sau BasicAuth cua Traefik). Dat mat khau dai, ngau nhien.
# CANH BAO ESCAPING: neu mat khau co ky tu "$" thi phai viet thanh "$$",
# vi du mat khau that la  a$b  thi o day ghi  a$$b
CODE_SERVER_PASSWORD=doi-mat-khau-nay-di

# -----------------------------------------------------------------------------
#  BASIC AUTH (lop bao ve thu 1, do Traefik xu ly)
#  Hai dong duoi do scripts/setup.sh sinh tu dong. Neu tu tay dien:
#     htpasswd -nbB admin 'matkhau'
#  se cho ra chuoi dang   admin:$2y$05$abc...
#  -> BASIC_AUTH_USER = phan truoc dau ":"
#  -> BASIC_AUTH_HASH = phan sau dau ":", VA PHAI THAY MOI "$" THANH "$$"
#     vi du hash that   $2y$05$abc   ->   ghi o day la   $$2y$$05$$abc
#  Ly do: Docker Compose noi suy bien ngay trong file .env, "$" la ky tu dac biet.
# -----------------------------------------------------------------------------
BASIC_AUTH_USER=admin
BASIC_AUTH_HASH=

# -----------------------------------------------------------------------------
#  TUY CHON - co the giu nguyen
# -----------------------------------------------------------------------------

# Mui gio ap dung cho container code-server.
TZ=Asia/Ho_Chi_Minh

# Phien ban Claude Code cai vao image. Mac dinh "latest".
# Ghim mot so cu the neu ban moi nhat bi loi, vi du: CLAUDE_CODE_VERSION=2.1.100
CLAUDE_CODE_VERSION=latest

# Gioi han tai nguyen cho container claude-code.
# Claude Code khuyen nghi toi thieu 4 GB RAM cho may chu.
# VPS 4 GB  -> CLAUDE_MEM_LIMIT=3g
# VPS 8 GB  -> CLAUDE_MEM_LIMIT=6g
CLAUDE_MEM_LIMIT=3g
CLAUDE_CPU_LIMIT=2

# -----------------------------------------------------------------------------
#  XAC THUC THAY THE (mac dinh KHONG dung - xem Phu luc A/B trong HUONG-DAN.md)
#
#  Mac dinh stack nay dang nhap bang tai khoan Claude Pro/Max qua lenh `claude`
#  trong terminal cua code-server. Chi bo comment ben duoi neu ban co ly do ro rang.
#
#  ANTHROPIC_API_KEY co do UU TIEN CAO HON subscription: neu set, moi request
#  se tinh phi theo API chu KHONG dung goi thue bao Pro/Max.
#  Neu bo comment o day thi phai bo comment dong tuong ung trong docker-compose.yml.
# -----------------------------------------------------------------------------
# ANTHROPIC_API_KEY=
# CLAUDE_CODE_OAUTH_TOKEN=
